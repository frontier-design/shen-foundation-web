{
  "crons": [{ "path": "/api/cron/cleanup-videos", "schedule": "0 6 * * 1" }],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/" }
  ],
  "images": {
    "sizes": [640, 960, 1280, 1920],
    "qualities": [80],
    "formats": ["image/webp"],
    "localPatterns": [{ "pathname": "^/media/.*$", "search": "" }],
    "minimumCacheTTL": 2678400
  }
}
